# Deployer key (never commit a real key). Needs BOT for gas.
DEPLOYER_PRIVATE_KEY=

# Roles granted at deploy time. Default to the deployer when empty.
STAKE_CREATOR_ADDRESS=
STAKE_RESOLVER_ADDRESS=
STAKE_TREASURY_ADDRESS=

# Protocol fee in basis points (max 500 = 5%). See README "Fee model".
STAKE_FEE_BPS=100

# Network overrides. Re-verify against https://dev-docs.botchain.ai before deploying.
BOT_TESTNET_CHAIN_ID=968
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_TESTNET_EXPLORER=https://scan.bohr.life
BOT_MAINNET_CHAIN_ID=677
BOT_MAINNET_RPC=https://rpc.botchain.ai
BOT_MAINNET_EXPLORER=https://scan.botchain.ai
