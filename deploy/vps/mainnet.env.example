# Copy to resolver/.env.mainnet (gitignored) and chmod 600. Used by stake-resolver-mainnet.service.
# Values verified 2026-10-10: eth_chainId on https://rpc.botchain.ai = 0x2a5 (677).
STAKE_CHAIN_ID=677
STAKE_RPC_URL=https://rpc.botchain.ai
# Mainnet StakeMarkets (deployed 2026-10-10, block 26193710, source verified)
STAKE_CONTRACT=0xBf263D8333f21aA55504Adb6404b0a493fb9D838
# Optional: set this to use a dedicated mainnet resolver wallet. When unset, the key in resolver/.env is used.
# RESOLVER_PRIVATE_KEY=
