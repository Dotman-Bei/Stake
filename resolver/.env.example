# Chain STAKE is deployed on. Re-verify against https://dev-docs.botchain.ai before use.
# Testnet: 968 / https://rpc.bohr.life     Mainnet: 677 / https://rpc.botchain.ai
STAKE_CHAIN_ID=968
STAKE_RPC_URL=https://rpc.bohr.life
# Optional: defaults to contracts/deployments/<STAKE_CHAIN_ID>.json
STAKE_CONTRACT=

# Key of an account granted the resolver role. Keep it on a dedicated, low-balance hot wallet.
RESOLVER_PRIVATE_KEY=

POLL_SECONDS=15
GIVE_UP_MARGIN_SECONDS=3600

# RPCs used to read on-chain metrics (txCount / erc20Supply markets).
DATA_RPC_677=https://rpc.botchain.ai
DATA_RPC_968=https://rpc.bohr.life
