# Which BOT Chain network the app talks to: testnet | mainnet | local
NEXT_PUBLIC_STAKE_NETWORK=testnet
# StakeMarkets address and its deployment block (see contracts/deployments/<chainId>.json)
NEXT_PUBLIC_STAKE_CONTRACT=
NEXT_PUBLIC_STAKE_DEPLOY_BLOCK=0
# Optional RPC override. Defaults are the official endpoints verified 2026-10-05.
NEXT_PUBLIC_STAKE_RPC=
